[
  {
    "id": "selectors-list",
    "description": "Lists all available contracts including non-SDK",
    "command": ["selectors.mjs", "list"],
    "expect": {
      "exitCode": 0,
      "stdout": {
        "type": "text",
        "contains": ["CFAv1Forwarder", "SuperToken", "FluidLocker", "ClearMacroForwarder", "BlindMacroForwarder", "CFASuperAppBase (non-SDK)", "ClearMacroBase (non-SDK)"]
      }
    },
    "tags": ["smoke", "selectors"]
  },
  {
    "id": "selectors-single-contract",
    "description": "Generates correct selectors for FluidLocker",
    "command": ["selectors.mjs", "FluidLocker"],
    "expect": {
      "exitCode": 0,
      "stdout": {
        "type": "text",
        "contains": [
          "# FluidLocker selectors",
          "functions:",
          "stake(uint256):",
          "0xa694fc3a",
          "events:",
          "errors:",
          "NOT_LOCKER_OWNER():",
          "0x6318cf62"
        ]
      }
    },
    "tags": ["smoke", "selectors"]
  },
  {
    "id": "selectors-alias",
    "description": "Alias 'cfa' resolves to ConstantFlowAgreementV1",
    "command": ["selectors.mjs", "cfa"],
    "expect": {
      "exitCode": 0,
      "stdout": {
        "type": "text",
        "contains": ["# ConstantFlowAgreementV1 selectors", "CFA_FLOW_ALREADY_EXISTS():", "0x801b6863"]
      }
    },
    "tags": ["selectors"]
  },
  {
    "id": "selectors-sdk-forwarder",
    "description": "Generates correct selectors for ClearMacroForwarder from SDK ABI (not NON_SDK_ABIS)",
    "command": ["selectors.mjs", "ClearMacroForwarder"],
    "expect": {
      "exitCode": 0,
      "stdout": {
        "type": "text",
        "contains": [
          "# ClearMacroForwarder selectors — computed from @sfpro/sdk ABI",
          "runMacro(address,bytes,address,bytes):",
          "0xd3bc881e",
          "SELF_PROVIDER():",
          "0xdc254546",
          "InvalidSignature():",
          "0x8baa579f"
        ]
      }
    },
    "tags": ["selectors", "regression-t053"]
  },
  {
    "id": "selectors-blind-forwarder",
    "description": "Generates correct selectors for BlindMacroForwarder from SDK ABI; runMacro(address,bytes) selector differs from ClearMacroForwarder",
    "command": ["selectors.mjs", "BlindMacroForwarder"],
    "expect": {
      "exitCode": 0,
      "stdout": {
        "type": "text",
        "contains": [
          "# BlindMacroForwarder selectors — computed from @sfpro/sdk ABI",
          "runMacro(address,bytes):",
          "0x651aeb70",
          "buildBatchOperations(address,bytes):",
          "0xb54bbfa0"
        ]
      }
    },
    "tags": ["selectors", "regression-t053"]
  },
  {
    "id": "selectors-non-sdk-interface",
    "description": "Generates correct selectors for ClearMacroBase from NON_SDK_ABIS",
    "command": ["selectors.mjs", "ClearMacroBase"],
    "expect": {
      "exitCode": 0,
      "stdout": {
        "type": "text",
        "contains": [
          "# ClearMacroBase selectors — computed from hardcoded NON_SDK_ABIS signatures",
          "getPrimaryTypeName(bytes):",
          "0x390b89cb",
          "getActionTypeDefinition(bytes):",
          "0x39f05f94",
          "UnknownActionId(uint8):"
        ]
      }
    },
    "tags": ["selectors", "regression-t049"]
  },
  {
    "id": "selectors-unknown-contract",
    "description": "Error for unknown contract name",
    "command": ["selectors.mjs", "NonexistentContract"],
    "expect": {
      "exitCode": 1,
      "stderr": { "contains": "Unknown contract" }
    },
    "tags": ["error-handling", "selectors"]
  }
]
